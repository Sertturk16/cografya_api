{
  // Jest config for the unit tests — `tools/` AND the pure `src/` modules with a
  // `.spec.ts` sibling (today: the MGM climate parser and its import assertions, which
  // need no database and so must not sit in the Testcontainers e2e suite).
  //
  // `isolatedModules: true` puts ts-jest in transpile-only mode. That is deliberate, not a
  // shortcut: tools source imports siblings with explicit `.ts` extensions (Node's native
  // type stripping requires them), which needs `allowImportingTsExtensions`, which in turn
  // requires `noEmit` — and ts-jest must emit. Transpiling sidesteps the conflict, and
  // nothing goes unchecked: `pnpm typecheck` type-checks `tools/` in full through
  // `tools/tsconfig.json`, specs included.
  "extends": "./tsconfig.spec.json",
  "compilerOptions": {
    "isolatedModules": true,
    // TS otherwise infers a common source directory from whichever files are
    // transformed and demands an explicit `rootDir` (TS5011).
    "rootDir": ".",
    // `moduleResolution: node10` is inherited from `tsconfig.spec.json` and is deprecated
    // in TS 6. It cannot be raised here in isolation (node16/bundler require a matching
    // `module`, and Jest needs CommonJS), so the deprecation is acknowledged explicitly
    // rather than silenced globally. Revisit when the spec configs move to node16.
    "ignoreDeprecations": "6.0"
  }
}
