{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Liveness probe — returns ok when the API is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/provinces": {
      "get": {
        "operationId": "ProvinceController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProvinceListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all provinces (lean payload for the il-hub + map).",
        "tags": [
          "provinces"
        ]
      }
    },
    "/api/provinces/map-summary": {
      "get": {
        "operationId": "ProvinceController_findMapSummary",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProvinceMapSummaryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Bulk hover-card summary for all provinces (homepage SVG map, build-time embed).",
        "tags": [
          "provinces"
        ]
      }
    },
    "/api/provinces/{slug}": {
      "get": {
        "operationId": "ProvinceController_findBySlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "TR or EN slug of the province.",
            "schema": {
              "example": "istanbul",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvinceDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "No province matches the given slug."
          }
        },
        "summary": "Get one province by its TR or EN slug (full detail).",
        "tags": [
          "provinces"
        ]
      }
    },
    "/api/countries": {
      "get": {
        "operationId": "CountryController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all countries (lean payload for the /dunya hub + map).",
        "tags": [
          "countries"
        ]
      }
    },
    "/api/countries/map-summary": {
      "get": {
        "operationId": "CountryController_findMapSummary",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryMapSummaryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Bulk hover-card summary for all countries (world SVG map, build-time embed).",
        "tags": [
          "countries"
        ]
      }
    },
    "/api/countries/{slug}": {
      "get": {
        "operationId": "CountryController_findBySlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "TR or EN slug of the country.",
            "schema": {
              "example": "turkiye",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "No country matches the given slug."
          }
        },
        "summary": "Get one country by its TR or EN slug (full detail).",
        "tags": [
          "countries"
        ]
      }
    }
  },
  "info": {
    "title": "Coğrafya API",
    "description": "Backend API for the Coğrafya education platform.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Liveness status of the API. Always \"ok\" when the service responds."
          }
        },
        "required": [
          "status"
        ]
      },
      "ProvinceListItemDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu (stable, unique)."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          },
          "climateKoppen": {
            "type": "string",
            "nullable": true,
            "example": "Csa",
            "description": "Köppen iklim kısa kodu (MGM 2023). Liste DTO’suna bilinçli eklendi: \"benzer iklime sahip iller\" bloğu bu alan olmadan kurulamaz (aynı Köppen kodlu illere çapraz link). Saf toplama, kırıcı değil."
          },
          "climateAnnualMeanTempC": {
            "type": "number",
            "nullable": true,
            "example": 14.2,
            "description": "Yıllık ortalama sıcaklık (°C) — 12 aylık ortalamanın ortalaması, 1 ondalık. Detay DTO’sundaki climate.derived.annualMeanTempC ile AYNI türetilmiş değerdir (tek kaynak: climate-derivations.ts; liste yolunda yeniden türetilmez, aynı buildClimate çağrısıyla canlı hesaplanır). Benzer-iklim bloğunun \"en yakın 5\" seçimi (→ DEC 2026-07-20b) ve çapa metnindeki \"il adı + °C\" bu alan olmadan kurulamaz. İlin yayınlanabilir iklim serisi yoksa null. Saf toplama, kırıcı değil."
          }
        },
        "required": [
          "plateCode",
          "nameTr",
          "region",
          "slugTr",
          "slugEn",
          "climateKoppen",
          "climateAnnualMeanTempC"
        ]
      },
      "ProvinceMapSummaryDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu (stable, unique)."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key — kart tıklaması)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          },
          "population": {
            "type": "number",
            "nullable": true,
            "example": 15754053,
            "description": "Nüfus (TÜİK ADNKS). Null until fact-checked."
          },
          "populationYear": {
            "type": "number",
            "nullable": true,
            "example": 2025,
            "description": "Nüfus referans yılı."
          },
          "areaKm2": {
            "type": "number",
            "nullable": true,
            "example": 5461,
            "description": "Yüzölçümü (km², HGM)."
          },
          "districtCount": {
            "type": "number",
            "nullable": true,
            "example": 39,
            "description": "İlçe sayısı."
          }
        },
        "required": [
          "plateCode",
          "nameTr",
          "region",
          "slugTr",
          "slugEn",
          "population",
          "populationYear",
          "areaKm2",
          "districtCount"
        ]
      },
      "ClimateMonthlyNormalDto": {
        "type": "object",
        "properties": {
          "month": {
            "type": "number",
            "example": 7,
            "description": "1 = Ocak … 12 = Aralık."
          },
          "tempMeanC": {
            "type": "number",
            "nullable": true,
            "example": 27.9,
            "description": "Ortalama sıcaklık (°C). Çekirdek çift — yayınlanan her ilde doludur."
          },
          "tempMaxMeanC": {
            "type": "number",
            "nullable": true,
            "example": 33.2,
            "description": "Ortalama en yüksek sıcaklık (°C)."
          },
          "tempMinMeanC": {
            "type": "number",
            "nullable": true,
            "example": 22.6,
            "description": "Ortalama en düşük sıcaklık (°C)."
          },
          "precipitationMm": {
            "type": "number",
            "nullable": true,
            "example": 4.7,
            "description": "Aylık toplam yağış miktarı ortalaması (mm). Çekirdek çift."
          },
          "sunshineHours": {
            "type": "number",
            "nullable": true,
            "example": 11.2,
            "description": "Ortalama günlük güneşlenme süresi (saat)."
          },
          "rainyDays": {
            "type": "number",
            "nullable": true,
            "example": 2.1,
            "description": "Ortalama yağışlı gün sayısı."
          },
          "tempRecordMaxC": {
            "type": "number",
            "nullable": true,
            "example": 45.6,
            "description": "O ay ölçülmüş en yüksek sıcaklık (°C) — uç değer, ortalama değil."
          },
          "tempRecordMaxDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "example": "2000-07-30",
            "description": "`tempRecordMaxC` gerçekleşme tarihi (ISO YYYY-MM-DD). Değerden bağımsız nullable."
          },
          "tempRecordMinC": {
            "type": "number",
            "nullable": true,
            "example": 12.3,
            "description": "O ay ölçülmüş en düşük sıcaklık (°C) — uç değer, ortalama değil."
          },
          "tempRecordMinDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "example": "1976-07-05",
            "description": "`tempRecordMinC` gerçekleşme tarihi (ISO YYYY-MM-DD). Değerden bağımsız nullable."
          }
        },
        "required": [
          "month",
          "tempMeanC",
          "tempMaxMeanC",
          "tempMinMeanC",
          "precipitationMm",
          "sunshineHours",
          "rainyDays",
          "tempRecordMaxC",
          "tempRecordMaxDate",
          "tempRecordMinC",
          "tempRecordMinDate"
        ]
      },
      "ClimateExtremeRecordDto": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 189.4,
            "description": "Ölçülen uç değer (ham sayı)."
          },
          "date": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "example": "1968-12-26",
            "description": "Gerçekleşme tarihi (ISO YYYY-MM-DD). MGM tarihi basmadıysa null — değerden bağımsız nullable."
          }
        },
        "required": [
          "value",
          "date"
        ]
      },
      "ClimateRecordsDto": {
        "type": "object",
        "properties": {
          "dailyMaxPrecipitationMm": {
            "nullable": true,
            "description": "Günlük toplam en yüksek yağış miktarı (mm).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClimateExtremeRecordDto"
              }
            ]
          },
          "fastestWindMs": {
            "nullable": true,
            "description": "Günlük en hızlı rüzgâr (m/sn).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClimateExtremeRecordDto"
              }
            ]
          },
          "maxSnowDepthCm": {
            "nullable": true,
            "description": "En yüksek kar yüksekliği (cm).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClimateExtremeRecordDto"
              }
            ]
          }
        },
        "required": [
          "dailyMaxPrecipitationMm",
          "fastestWindMs",
          "maxSnowDepthCm"
        ]
      },
      "SeasonalPrecipitationDto": {
        "type": "object",
        "properties": {
          "winterPct": {
            "type": "number",
            "example": 45,
            "description": "Kış (Ara+Oca+Şub) yağış payı (%)."
          },
          "springPct": {
            "type": "number",
            "example": 27,
            "description": "İlkbahar (Mar+Nis+May) yağış payı (%)."
          },
          "summerPct": {
            "type": "number",
            "example": 6,
            "description": "Yaz (Haz+Tem+Ağu) yağış payı (%)."
          },
          "autumnPct": {
            "type": "number",
            "example": 22,
            "description": "Sonbahar (Eyl+Eki+Kas) yağış payı (%)."
          }
        },
        "required": [
          "winterPct",
          "springPct",
          "summerPct",
          "autumnPct"
        ]
      },
      "ClimateDerivedDto": {
        "type": "object",
        "properties": {
          "annualMeanTempC": {
            "type": "number",
            "example": 19.1,
            "description": "Yıllık ortalama sıcaklık (°C) — 12 aylık ortalamanın ortalaması (TÜRETİLMİŞ, MGM değil)."
          },
          "annualPrecipitationMm": {
            "type": "number",
            "example": 592.4,
            "description": "Yıllık toplam yağış (mm) — 12 aylık toplamın toplamı (TÜRETİLMİŞ, MGM değil)."
          },
          "hottestMonth": {
            "type": "number",
            "example": 8,
            "description": "En sıcak ay (1-12)."
          },
          "coldestMonth": {
            "type": "number",
            "example": 1,
            "description": "En soğuk ay (1-12)."
          },
          "wettestMonth": {
            "type": "number",
            "example": 12,
            "description": "En yağışlı ay (1-12)."
          },
          "driestMonth": {
            "type": "number",
            "example": 7,
            "description": "En kurak ay (1-12)."
          },
          "annualTempRangeC": {
            "type": "number",
            "example": 20.4,
            "description": "Yıllık sıcaklık farkı (°C) — en sıcak ile en soğuk ay ortalaması arası (TÜRETİLMİŞ)."
          },
          "seasonalPrecipitation": {
            "description": "Mevsimsel yağış yüzdeleri (tam 100 eder) — TÜRETİLMİŞ.",
            "allOf": [
              {
                "$ref": "#/components/schemas/SeasonalPrecipitationDto"
              }
            ]
          }
        },
        "required": [
          "annualMeanTempC",
          "annualPrecipitationMm",
          "hottestMonth",
          "coldestMonth",
          "wettestMonth",
          "driestMonth",
          "annualTempRangeC",
          "seasonalPrecipitation"
        ]
      },
      "ClimateDto": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "mgm_general"
            ],
            "example": "mgm_general",
            "description": "Kaynak seri kimliği — MGM Genel İstatistik tablosu (k=A), 81 il için tek seri."
          },
          "sourceUrl": {
            "type": "string",
            "example": "https://www.mgm.gov.tr/veridegerlendirme/il-ve-ilceler-istatistik.aspx?k=A&m=ICEL",
            "description": "Bu serinin okunduğu MGM sayfası — il başına (MGM anahtarı Türkçe adla aynı değil)."
          },
          "periodStartYear": {
            "type": "number",
            "example": 1929,
            "description": "Ölçüm periyodu başlangıç yılı — il başına değişir, sayfadan okunur."
          },
          "periodEndYear": {
            "type": "number",
            "example": 2025,
            "description": "Ölçüm periyodu bitiş yılı."
          },
          "months": {
            "description": "Aylık normaller — tam 12 ay, 1-12 sırasıyla.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClimateMonthlyNormalDto"
            }
          },
          "records": {
            "description": "Tüm zamanların rekorları.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClimateRecordsDto"
              }
            ]
          },
          "derived": {
            "description": "Seriden TÜRETİLMİŞ yıllık/uç/mevsimsel değerler — MGM’e atfedilemez.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ClimateDerivedDto"
              }
            ]
          }
        },
        "required": [
          "source",
          "sourceUrl",
          "periodStartYear",
          "periodEndYear",
          "months",
          "records",
          "derived"
        ]
      },
      "HydrographyFeatureDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ömerli Barajı",
            "description": "Öz ad."
          },
          "type": {
            "enum": [
              "baraj",
              "nehir",
              "gol"
            ],
            "type": "string",
            "example": "baraj",
            "description": "Özellik türü (baraj/nehir/göl) — ASCII değer; TR etiketi web tarafında."
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "EconomyIndicatorDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "GSYH'de Türkiye payı",
            "description": "İstatistiğin ölçtüğü büyüklük."
          },
          "value": {
            "type": "string",
            "example": "%30,2",
            "description": "Değer, string — pay/sıra/ürün adı olabildiği için (heterojen)."
          },
          "year": {
            "type": "number",
            "example": 2024,
            "description": "İstatistiğin referans yılı."
          },
          "source": {
            "type": "string",
            "example": "TÜİK Bölgesel GSYH",
            "description": "Otoriter kaynak."
          }
        },
        "required": [
          "label",
          "value",
          "year",
          "source"
        ]
      },
      "ProvinceDetailDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "introTr": {
            "type": "string",
            "nullable": true,
            "example": "İstanbul, Karadeniz ile Marmara Denizi'ni birbirine bağlayan Boğaz'ın iki yakasına kurulmuştur.",
            "description": "Yazılı açılış cümlesi (il girişi). Null ise web veri-tabanlı bir cümle kurar (fallback)."
          },
          "population": {
            "type": "number",
            "nullable": true,
            "example": 15754053,
            "description": "Nüfus (TÜİK ADNKS). Null until fact-checked."
          },
          "populationYear": {
            "type": "number",
            "nullable": true,
            "example": 2025,
            "description": "Nüfus referans yılı."
          },
          "areaKm2": {
            "type": "number",
            "nullable": true,
            "example": 5461,
            "description": "Yüzölçümü (km², HGM)."
          },
          "districtCount": {
            "type": "number",
            "nullable": true,
            "example": 39,
            "description": "İlçe sayısı."
          },
          "populationDensity": {
            "type": "number",
            "nullable": true,
            "example": 2885,
            "description": "Nüfus yoğunluğu (kişi/km²) — SERVER-COMPUTED, not stored: round(nüfus / yüzölçümü). Null when population or area is null. Consume this rather than recomputing, so the rounding/null rule stays single-sourced."
          },
          "elevationM": {
            "type": "number",
            "nullable": true,
            "example": 33,
            "description": "İl merkezi rakımı (m) — MGM il-merkez istasyonu referansı."
          },
          "latitude": {
            "type": "number",
            "nullable": true,
            "example": 40.9819,
            "description": "İl merkezi enlemi (decimal degrees) — MGM il-merkez istasyonu."
          },
          "longitude": {
            "type": "number",
            "nullable": true,
            "example": 28.8208,
            "description": "İl merkezi boylamı (decimal degrees) — MGM il-merkez istasyonu."
          },
          "neighborPlateCodes": {
            "example": [
              "59",
              "41"
            ],
            "description": "Komşu illerin plaka kodları (hub-and-spoke için).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "climateKoppen": {
            "type": "string",
            "nullable": true,
            "example": "Csa",
            "description": "Köppen iklim kısa kodu (MGM 2023)."
          },
