{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Liveness probe — returns ok when the API is up.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/provinces": {
      "get": {
        "operationId": "ProvinceController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProvinceListItemDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List all provinces (lean payload for the il-hub + map).",
        "tags": [
          "provinces"
        ]
      }
    },
    "/api/provinces/map-summary": {
      "get": {
        "operationId": "ProvinceController_findMapSummary",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProvinceMapSummaryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Bulk hover-card summary for all provinces (homepage SVG map, build-time embed).",
        "tags": [
          "provinces"
        ]
      }
    },
    "/api/provinces/{slug}": {
      "get": {
        "operationId": "ProvinceController_findBySlug",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "description": "TR or EN slug of the province.",
            "schema": {
              "example": "istanbul",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvinceDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "No province matches the given slug."
          }
        },
        "summary": "Get one province by its TR or EN slug (full detail).",
        "tags": [
          "provinces"
        ]
      }
    }
  },
  "info": {
    "title": "Coğrafya API",
    "description": "Backend API for the Coğrafya education platform.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "Liveness status of the API. Always \"ok\" when the service responds."
          }
        },
        "required": [
          "status"
        ]
      },
      "ProvinceListItemDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu (stable, unique)."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          }
        },
        "required": [
          "plateCode",
          "nameTr",
          "region",
          "slugTr",
          "slugEn"
        ]
      },
      "ProvinceMapSummaryDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu (stable, unique)."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key — kart tıklaması)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          },
          "population": {
            "type": "number",
            "nullable": true,
            "example": 15754053,
            "description": "Nüfus (TÜİK ADNKS). Null until fact-checked."
          },
          "populationYear": {
            "type": "number",
            "nullable": true,
            "example": 2025,
            "description": "Nüfus referans yılı."
          },
          "areaKm2": {
            "type": "number",
            "nullable": true,
            "example": 5461,
            "description": "Yüzölçümü (km², HGM)."
          },
          "districtCount": {
            "type": "number",
            "nullable": true,
            "example": 39,
            "description": "İlçe sayısı."
          }
        },
        "required": [
          "plateCode",
          "nameTr",
          "region",
          "slugTr",
          "slugEn",
          "population",
          "populationYear",
          "areaKm2",
          "districtCount"
        ]
      },
      "HydrographyFeatureDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ömerli Barajı",
            "description": "Öz ad."
          },
          "type": {
            "enum": [
              "baraj",
              "nehir",
              "gol"
            ],
            "type": "string",
            "example": "baraj",
            "description": "Özellik türü (baraj/nehir/göl) — ASCII değer; TR etiketi web tarafında."
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "EconomyIndicatorDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "GSYH'de Türkiye payı",
            "description": "İstatistiğin ölçtüğü büyüklük."
          },
          "value": {
            "type": "string",
            "example": "%30,2",
            "description": "Değer, string — pay/sıra/ürün adı olabildiği için (heterojen)."
          },
          "year": {
            "type": "number",
            "example": 2024,
            "description": "İstatistiğin referans yılı."
          },
          "source": {
            "type": "string",
            "example": "TÜİK Bölgesel GSYH",
            "description": "Otoriter kaynak."
          }
        },
        "required": [
          "label",
          "value",
          "year",
          "source"
        ]
      },
      "ProvinceDetailDto": {
        "type": "object",
        "properties": {
          "plateCode": {
            "type": "string",
            "example": "34",
            "description": "Plaka kodu."
          },
          "nameTr": {
            "type": "string",
            "example": "İstanbul",
            "description": "İl adı (TR)."
          },
          "slugTr": {
            "type": "string",
            "example": "istanbul",
            "description": "TR slug (routing key)."
          },
          "slugEn": {
            "type": "string",
            "example": "istanbul",
            "description": "EN slug (routing key)."
          },
          "region": {
            "enum": [
              "MARMARA",
              "EGE",
              "AKDENIZ",
              "IC_ANADOLU",
              "KARADENIZ",
              "DOGU_ANADOLU",
              "GUNEYDOGU_ANADOLU"
            ],
            "type": "string",
            "description": "Coğrafi bölge."
          },
          "introTr": {
            "type": "string",
            "nullable": true,
            "example": "İstanbul, Karadeniz ile Marmara Denizi'ni birbirine bağlayan Boğaz'ın iki yakasına kurulmuştur.",
            "description": "Yazılı açılış cümlesi (il girişi). Null ise web veri-tabanlı bir cümle kurar (fallback)."
          },
          "population": {
            "type": "number",
            "nullable": true,
            "example": 15754053,
            "description": "Nüfus (TÜİK ADNKS). Null until fact-checked."
          },
          "populationYear": {
            "type": "number",
            "nullable": true,
            "example": 2025,
            "description": "Nüfus referans yılı."
          },
          "areaKm2": {
            "type": "number",
            "nullable": true,
            "example": 5461,
            "description": "Yüzölçümü (km², HGM)."
          },
          "districtCount": {
            "type": "number",
            "nullable": true,
            "example": 39,
            "description": "İlçe sayısı."
          },
          "populationDensity": {
            "type": "number",
            "nullable": true,
            "example": 2885,
            "description": "Nüfus yoğunluğu (kişi/km²) — SERVER-COMPUTED, not stored: round(nüfus / yüzölçümü). Null when population or area is null. Consume this rather than recomputing, so the rounding/null rule stays single-sourced."
          },
          "elevationM": {
            "type": "number",
            "nullable": true,
            "example": 33,
            "description": "İl merkezi rakımı (m) — MGM il-merkez istasyonu referansı."
          },
          "latitude": {
            "type": "number",
            "nullable": true,
            "example": 40.9819,
            "description": "İl merkezi enlemi (decimal degrees) — MGM il-merkez istasyonu."
          },
          "longitude": {
            "type": "number",
            "nullable": true,
            "example": 28.8208,
            "description": "İl merkezi boylamı (decimal degrees) — MGM il-merkez istasyonu."
          },
          "neighborPlateCodes": {
            "example": [
              "59",
              "41"
            ],
            "description": "Komşu illerin plaka kodları (hub-and-spoke için).",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "climateKoppen": {
            "type": "string",
            "nullable": true,
            "example": "Csa",
            "description": "Köppen iklim kısa kodu (MGM 2023)."
          },
          "climateClassTr": {
            "type": "string",
            "nullable": true,
            "example": "Akdeniz iklimi",
            "description": "MGM Türkçe iklim sınıf adı."
          },
          "climateNoteTr": {
            "type": "string",
            "nullable": true,
            "example": "MGM'nin 2023 Köppen sınıflandırması bu ili Csa (Akdeniz iklimi) olarak verir; ancak MGM'nin kendi raporu bu basitleştirilmiş yöntemin bölgesel ayırt ediciliğinin sınırlı olduğunu not düşer.",
            "description": "MGM Köppen metodolojik uyarı notu — Köppen değeriyle birlikte ZORUNLU olarak sunulur (bare bir 'Csa' yayınlanmaz)."
          },
          "landformNoteTr": {
            "type": "string",
            "nullable": true,
            "description": "Öne çıkan yer şekilleri / jeoloji notu (TR)."
          },
          "hydrographyNoteTr": {
            "type": "string",
            "nullable": true,
            "description": "Hidrografya — kısa düzyazı not (nehir/göl/baraj anlatısı, TR)."
          },
          "hydrographyFeatures": {
            "nullable": true,
            "description": "Hidrografya — yapısal özellik listesi (baraj/nehir/göl). Null = araştırılmadı; boş dizi = \"belirgin özellik yok\" (bilinçli ifade).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HydrographyFeatureDto"
            }
          },
          "urbanizationRate": {
            "type": "number",
            "nullable": true,
            "example": 93.5,
            "description": "Şehirleşme oranı (%) — TÜİK ADNKS (il/ilçe merkezi nüfusu / toplam)."
          },
          "netMigrationRate": {
            "type": "number",
            "nullable": true,
            "example": 19.6,
            "description": "Net göç hızı (‰) — TÜİK Göç İstatistikleri; işaretli (net göç ± olabilir)."
          },
          "settlementNoteTr": {
            "type": "string",
            "nullable": true,
            "description": "Nüfus ve yerleşme — kısa düzyazı not (TR)."
          },
          "economyIndicator": {
            "nullable": true,
            "description": "Ekonomik coğrafya — TEK, TÜİK-çıpalı yapısal istatistik (serbest metin değil).",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/EconomyIndicatorDto"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Kayıt oluşturulma zamanı."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Son güncelleme zamanı (SEO dateModified / sitemap lastmod)."
          }
        },
        "required": [
          "plateCode",
          "nameTr",
          "slugTr",
          "slugEn",
          "region",
          "introTr",
          "population",
          "populationYear",
          "areaKm2",
          "districtCount",
          "populationDensity",
          "elevationM",
          "latitude",
          "longitude",
          "neighborPlateCodes",
          "climateKoppen",
          "climateClassTr",
          "climateNoteTr",
          "landformNoteTr",
          "hydrographyNoteTr",
          "hydrographyFeatures",
          "urbanizationRate",
          "netMigrationRate",
          "settlementNoteTr",
          "economyIndicator",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  }
}
