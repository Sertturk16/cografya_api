# Dependencies
/node_modules

# Build output
/dist
/build

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment (secrets — never commit; .env.example IS committed)
.env
.env.local
.env.*.local

# Test / coverage
/coverage
/.nyc_output

# PR-review run workspace — reviewers write pr-reviews/{PR#}-{role}.md here per run;
# Atlas archives the consolidated file to Owner's Inbox/pr-review-archive/. Transient,
# never committed (workflow: the orchestration-root REVIEW-POLICY.md; rubrics: .claude/reviewers/).
/pr-reviews/

# ERA5-Land raw downloads — a BELT, not the primary control.
# `db:import:era5 --phase=fetch` REQUIRES an explicit absolute `--raw-dir`, so the raw
# 19 801 767 B `.nc` normally never comes near the repo. This entry catches the case where
# somebody points `--raw-dir` here deliberately. The committed artifacts next to it
# (`era5-manifest.json`, `era5-province-series.json`) identify that file by SHA-256 forever.
/data/era5-land/raw/
/data/era5-land/*.nc
/data/era5-land/*.nc.part

# TypeScript build info
*.tsbuildinfo

# Husky internals (generated on install)
.husky/_

# Editor / OS
.DS_Store
.idea
*.swp
.vscode/*
!.vscode/extensions.json
