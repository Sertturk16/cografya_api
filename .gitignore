# Dependencies
/node_modules

# Build output
/dist
/build

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment (secrets — never commit; .env.example IS committed)
.env
.env.local
.env.*.local

# Test / coverage
/coverage
/.nyc_output

# PR-review run workspace — reviewers write pr-reviews/{PR#}-{role}.md here per run;
# Atlas archives the consolidated file to Owner's Inbox/pr-review-archive/. Transient,
# never committed (workflow: the orchestration-root REVIEW-POLICY.md; rubrics: .claude/reviewers/).
/pr-reviews/

# ERA5-Land raw downloads — a BELT, not the primary control.
# `db:import:era5 --phase=fetch` REQUIRES an explicit absolute `--raw-dir`, so the raw
# 19 801 767 B `.nc` normally never comes near the repo. This entry catches the case where
# somebody points `--raw-dir` here deliberately. The committed artifacts next to it
# (`era5-manifest.json`, `era5-province-series.json`) identify that file by SHA-256 forever.
/data/era5-land/raw/
/data/era5-land/*.nc
/data/era5-land/*.nc.part
# …and the job-evidence sidecar that now travels beside the raw file. The belt exists for the
# operator who points `--raw-dir` here, and that operator would otherwise leave a commitable
# `era5-land-1991-2020.nc.jobs.json`. It carries no key material (`writeArtifact` scans it), but
# it belongs to the uncommitted bytes, not to the repo (review #87, CR87-M3).
/data/era5-land/*.nc.jobs.json

# The artifacts of a FAILED run. They are kept on purpose — a failed run's evidence is what
# explains it — but they are by definition invalid, so they must never be committable. The
# generator writes `<name>.part`, gates, and only then renames; this makes the gate's failure
# mode unstageable rather than merely caught later by CI.
/data/era5-land/*.json.part

# CAMS raw downloads — the same BELT for the air-quality probe.
# `db:import:air-quality --phase=probe` REQUIRES an explicit absolute `--raw-dir`, so the
# ~32 MiB of per-run archives (forecast + analysis + mini) normally never come near the repo.
# This entry catches the case where somebody points `--raw-dir` here deliberately. The
# committed evidence next to it (`air-quality-probe.json`) identifies each archive by its
# provider MD5 forever.
/data/air-quality/raw/
/data/air-quality/*.zip

# TypeScript build info
*.tsbuildinfo

# Husky internals (generated on install)
.husky/_

# Editor / OS
.DS_Store
.idea
*.swp
.vscode/*
!.vscode/extensions.json
