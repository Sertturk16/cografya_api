# ─────────────────────────────────────────────────────────────
# Coğrafya API — environment template
# Copy to `.env` for local development. `.env` is gitignored.
# Only the variables validated by src/config/env.schema.ts are read by the app
# at boot; an invalid value — or a missing value for any var without a default —
# kills boot (fail-fast). NODE_ENV, PORT and WEB_ORIGIN carry safe defaults;
# DATABASE_URL has NO default, so leaving it unset aborts startup.
# ─────────────────────────────────────────────────────────────

# ── Application (validated by env.schema.ts) ──
NODE_ENV=development
PORT=3000

# REQUIRED — no default. Postgres connection string the app connects with.
# Must match the docker-compose Postgres below (user:password@host:port/db).
DATABASE_URL=postgresql://cografya:cografya_dev@localhost:5432/cografya

# Browser origin of the web app, allowed by CORS. Defaults to the local Next.js
# dev origin; set the real domain in production.
WEB_ORIGIN=http://localhost:3000

# ── Local infrastructure (consumed by docker-compose to provision Postgres) ──
# Dev-only defaults; NOT secrets. Real credentials live in the deployment
# environment once hosting is decided. Keep these in sync with DATABASE_URL.
POSTGRES_USER=cografya
POSTGRES_PASSWORD=cografya_dev
POSTGRES_DB=cografya
POSTGRES_PORT=5432
REDIS_PORT=6379
