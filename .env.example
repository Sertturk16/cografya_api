# ─────────────────────────────────────────────────────────────
# Coğrafya API — environment template
# Copy to `.env` for local development. `.env` is gitignored.
# Only the variables validated by src/config/env.schema.ts are read by the app
# at boot; an invalid value — or a missing value for any var without a default —
# kills boot (fail-fast). NODE_ENV, PORT and WEB_ORIGIN carry safe defaults;
# DATABASE_URL has NO default, so leaving it unset aborts startup.
# ─────────────────────────────────────────────────────────────

# ── Application (validated by env.schema.ts) ──
# REQUIRED — no default. The production Redis rule (E1 / DEC 2026-07-29b) keys on this value, so
# an environment that does not state which one it is does not boot.
NODE_ENV=development
# 3001, not 3000: the web app's Next.js dev server owns 3000 (WEB_ORIGIN below).
PORT=3001

# REQUIRED — no default. Postgres connection string the app connects with.
# Must match the docker-compose Postgres below (user:password@host:port/db).
DATABASE_URL=postgresql://cografya:cografya_dev@localhost:5432/cografya

# Browser origin of the web app, allowed by CORS. Defaults to the local Next.js
# dev origin; set the real domain in production.
WEB_ORIGIN=http://localhost:3000

# OPTIONAL shared secret that exempts the trusted first-party caller (the web SSG
# build) from the global rate limit. Presented in the `x-internal-request-token`
# header. Fail-closed: leave it UNSET locally and the exemption simply does not
# exist (every request is throttled). When set it MUST be >= 32 chars. It is a
# SECRET — set it only in the deployment/build environment, never commit a real
# value, and only the web build's SERVER-SIDE fetches may hold it (never the browser).
# The web repo's `cografya_web/.env` must hold the SAME string, byte for byte.
#
# HOW TO MINT IT — `openssl rand -hex 32`. One line, nothing else:
#   · An EMPTY assignment is invalid (>= 32 chars) — comment the line out instead.
#   · NEVER a wrapped `openssl rand -base64 64`: openssl breaks base64 at 64 columns, so
#     the value carries a newline. An UNQUOTED multiline value in a .env FILE never even
#     reaches the zod schema — dotenv truncates it to its first line — and that truncated
#     half then mismatches the web while looking correct in both stores. No code-level
#     validation can see it, which is why this line is the control.
#   · Keep the value to ONE line of visible ASCII: no spaces, no quoted-newline tricks,
#     no non-ASCII. `env.schema.ts` rejects all of them at boot, and for the whitespace
#     case it has to: Node's HTTP parser trims a header value's edges, so a token with an
#     edge space can never be presented back to us — the caller gets permanent 429s while
#     our boot log still reports "exemption: active".
# INTERNAL_REQUEST_TOKEN=

# ── Cache (validated by env.schema.ts) ──
# Redis for the upstream cache, the single-flight refresh lock and the shared provider-budget
# counters. OPTIONAL in development/test: leave it unset and the app falls back to an in-process
# LRU, which it announces loudly at boot. That fallback is SINGLE-INSTANCE only — every restart
# starts cold and single-flight cannot coordinate across processes.
# NOT optional in production with MARINE_ENABLED=true: boot then FAILS without it
# (owner ruling E1 / DEC 2026-07-29b). Points at the docker-compose Redis below.
# Must carry a HOST: `redis://` alone parses as a URL and ioredis quietly resolves it to
# localhost, which would satisfy E1 while pointing the cache at nothing.
# REDIS_URL=redis://localhost:6379

# ── Marine feature (SPEC-ADDENDUM §6/§7.8) ──
# Master switch for the marine UPSTREAM legs. `false` by default: a deployment must decide to
# turn it on, and per §3.4 it is flipped only after the first warmup tour has completed. It does
# NOT gate /api/marine/points or /api/marine/layers, which make no provider call.
# MARINE_ENABLED=false

# Total upstream budget for ONE user request — retries and parallel legs included — and the cap
# on any single call inside it. The second must not exceed the first.
# MARINE_UPSTREAM_DEADLINE_MS=6000
# MARINE_SINGLE_CALL_TIMEOUT_MS=3000

# The warmup tour: interval between tours, and the tour's OWN budget (background work, so it is
# not bound by the 6 s request deadline). The deadline must be shorter than the interval.
# MARINE_WARMUP_ENABLED=true
# MARINE_WARMUP_INTERVAL_SECONDS=900
# MARINE_WARMUP_DEADLINE_MS=300000

# ── ECMWF Open Data ingest (marine M3b; yeni-M3 SPEC §12) ──
# The scheduled ingest that downloads ECMWF wind/wave fields for the 30 reference points. A user
# request NEVER triggers an ECMWF call; only the warmup tour does, and only while BOTH
# MARINE_ENABLED and ECMWF_ENABLED are true.
# ECMWF_ENABLED=true
# ECMWF_BASE_URL=https://data.ecmwf.int/forecasts
# Optional S3 mirror; unset means no failover. (The mirror serves different Content-Type
# headers than the primary — the client accepts both by design.)
# ECMWF_FAILOVER_BASE_URL=https://ecmwf-forecasts.s3.eu-central-1.amazonaws.com
# Horizon in hours. 120 (5 days) is an owner ruling (O1); values above 120 refuse to boot
# because past +144 h the provider's step widens to 6 h and the frozen stepHours=3 contract
# would break. Lowering it is a cost lever.
# ECMWF_FORECAST_HOURS=120
# Per-download timeout (a ~1.8 MB Range GET does not fit the 3 s marine default), the slice of
# one warmup tour ECMWF may take, and the per-tour work ceiling.
# ECMWF_SINGLE_CALL_TIMEOUT_MS=20000
# ECMWF_TOUR_BUDGET_MS=180000
# ECMWF_MAX_STEPS_PER_TOUR=12
# Byte ceilings — breaching one stops the tour LOUDLY (the numeric "no unbounded external
# call"). Measured steady state: ~38 MB per 12-step tour, ~130 MB per full cycle.
# ECMWF_TOUR_MAX_BYTES=67108864
# ECMWF_CYCLE_MAX_BYTES=335544320
# Pre-HTTP cap on ONE planned byte range. The range length comes from the provider's .index and
# becomes our buffering ceiling for that download, so it is never accepted unbounded. 8 MiB is
# ~4.5x the largest measured merged range (~1.83 MB); a plan above it is refused loudly.
# ECMWF_MAX_RANGE_BYTES=8388608
# The THIRD staleness ceiling: maximum age of the model CYCLE a published value may come from.
# The two ceilings below cannot see this failure (an old cycle still yields a step valid "now").
# 24 h tolerates one fully missed cycle, never two.
# ECMWF_CYCLE_MAX_AGE_SECONDS=86400
# Cache-age ceiling of the ECMWF read path (its store refreshes 6-hourly by nature).
# ECMWF_STALE_MAX_SECONDS=43200

# ── CMEMS / Copernicus Marine adapter (marine M4) ──
# Anonymous endpoints — no key, no account, no token (verified 2026-08-02); none of these is a
# secret. The base URLs exist so e2e can point the adapter at a fake server.
# CMEMS_WMTS_BASE_URL=https://wmts.marine.copernicus.eu/teroWmts
# CMEMS_STAC_BASE_URL=https://stac.marine.copernicus.eu/metadata
# Per-call cap: a session's FIRST call measured 2.54 s (cold TLS), so the shared 3 s marine
# default would manufacture false timeouts. Must not exceed MARINE_UPSTREAM_DEADLINE_MS.
# CMEMS_SINGLE_CALL_TIMEOUT_MS=6000
# The slice of one warmup tour CMEMS may consume. ECMWF_TOUR_BUDGET_MS + CMEMS_TOUR_BUDGET_MS
# must stay below MARINE_WARMUP_DEADLINE_MS (checked at boot).
# CMEMS_TOUR_BUDGET_MS=60000
# How long a STAC dataset-id resolution is trusted; a mid-TTL dataset retirement self-heals via
# the 400-triggered forced re-resolution (once per tour).
# CMEMS_STAC_TTL_SECONDS=21600

# Cache TTLs, one per outcome kind. There is deliberately no single MARINE_CACHE_TTL_SECONDS:
# a land mask (permanent), a rate-limit answer (the provider says when) and a schema mismatch
# (an alarm) cannot share one number.
# MARINE_VALUE_TTL_SECONDS=3600
# MARINE_NO_DATA_TTL_SECONDS=86400
# MARINE_ERROR_TTL_SECONDS=60
# MARINE_RATELIMIT_TTL_SECONDS=300
# MARINE_CLIENT_ERROR_TTL_SECONDS=900
# MARINE_SCHEMA_ERROR_TTL_SECONDS=300

# The two independent staleness ceilings: how long we may keep serving a value we cannot
# refresh, and how old the MODEL MOMENT that value describes may be. Both are needed — a value
# fetched a minute ago can still belong to an eight-hour-old model run.
# MARINE_STALE_MAX_SECONDS=21600
# MARINE_VALID_AT_MAX_AGE_SECONDS=10800

# ── Local infrastructure (consumed by docker-compose to provision Postgres) ──
# Dev-only defaults; NOT secrets. Real credentials live in the deployment
# environment once hosting is decided. Keep these in sync with DATABASE_URL.
POSTGRES_USER=cografya
POSTGRES_PASSWORD=cografya_dev
POSTGRES_DB=cografya
POSTGRES_PORT=5432
REDIS_PORT=6379
