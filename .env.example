# ─────────────────────────────────────────────────────────────
# Coğrafya API — environment template
# Copy to `.env` for local development. `.env` is gitignored.
# Only the variables validated by src/config/env.schema.ts are read by the app
# at boot; an invalid value — or a missing value for any var without a default —
# kills boot (fail-fast). NODE_ENV, PORT and WEB_ORIGIN carry safe defaults;
# DATABASE_URL has NO default, so leaving it unset aborts startup.
# ─────────────────────────────────────────────────────────────

# ── Application (validated by env.schema.ts) ──
# REQUIRED — no default. The production Redis rule (E1 / DEC 2026-07-29b) keys on this value, so
# an environment that does not state which one it is does not boot.
NODE_ENV=development
# 3001, not 3000: the web app's Next.js dev server owns 3000 (WEB_ORIGIN below).
PORT=3001

# REQUIRED — no default. Postgres connection string the app connects with.
# Must match the docker-compose Postgres below (user:password@host:port/db).
DATABASE_URL=postgresql://cografya:cografya_dev@localhost:5432/cografya

# Browser origin of the web app, allowed by CORS. Defaults to the local Next.js
# dev origin; set the real domain in production.
WEB_ORIGIN=http://localhost:3000

# OPTIONAL shared secret that exempts the trusted first-party caller (the web SSG
# build) from the global rate limit. Presented in the `x-internal-request-token`
# header. Fail-closed: leave it UNSET locally and the exemption simply does not
# exist (every request is throttled). When set it MUST be >= 32 chars. It is a
# SECRET — set it only in the deployment/build environment, never commit a real
# value, and only the web build's SERVER-SIDE fetches may hold it (never the browser).
# The web repo's `cografya_web/.env` must hold the SAME string, byte for byte.
#
# HOW TO MINT IT — `openssl rand -hex 32`. One line, nothing else:
#   · An EMPTY assignment is invalid (>= 32 chars) — comment the line out instead.
#   · NEVER a wrapped `openssl rand -base64 64`: openssl breaks base64 at 64 columns, so
#     the value carries a newline. An UNQUOTED multiline value in a .env FILE never even
#     reaches the zod schema — dotenv truncates it to its first line — and that truncated
#     half then mismatches the web while looking correct in both stores. No code-level
#     validation can see it, which is why this line is the control.
#   · Keep the value to ONE line of visible ASCII: no spaces, no quoted-newline tricks,
#     no non-ASCII. `env.schema.ts` rejects all of them at boot, and for the whitespace
#     case it has to: Node's HTTP parser trims a header value's edges, so a token with an
#     edge space can never be presented back to us — the caller gets permanent 429s while
#     our boot log still reports "exemption: active".
# INTERNAL_REQUEST_TOKEN=

# ── Cache (validated by env.schema.ts) ──
# Redis for the upstream cache, the single-flight refresh lock and the shared provider-budget
# counters. OPTIONAL in development/test: leave it unset and the app falls back to an in-process
# LRU, which it announces loudly at boot. That fallback is SINGLE-INSTANCE only — every restart
# starts cold and single-flight cannot coordinate across processes.
# NOT optional in production with MARINE_ENABLED=true: boot then FAILS without it
# (owner ruling E1 / DEC 2026-07-29b). Points at the docker-compose Redis below.
# Must carry a HOST: `redis://` alone parses as a URL and ioredis quietly resolves it to
# localhost, which would satisfy E1 while pointing the cache at nothing.
# REDIS_URL=redis://localhost:6379

# ── Marine feature (SPEC-ADDENDUM §6/§7.8) ──
# Master switch for the marine UPSTREAM legs. `false` by default: a deployment must decide to
# turn it on, and per §3.4 it is flipped only after the first warmup tour has completed. It does
# NOT gate /api/marine/points or /api/marine/layers, which make no provider call.
# MARINE_ENABLED=false

# Total upstream budget for ONE user request — retries and parallel legs included — and the cap
# on any single call inside it. The second must not exceed the first.
# MARINE_UPSTREAM_DEADLINE_MS=6000
# MARINE_SINGLE_CALL_TIMEOUT_MS=3000

# The warmup tour: interval between tours, and the tour's OWN budget (background work, so it is
# not bound by the 6 s request deadline). The deadline must be shorter than the interval.
# MARINE_WARMUP_ENABLED=true
# MARINE_WARMUP_INTERVAL_SECONDS=900
# MARINE_WARMUP_DEADLINE_MS=300000

# ── ECMWF Open Data ingest (marine M3b; yeni-M3 SPEC §12) ──
# The scheduled ingest that downloads ECMWF wind/wave fields for the 30 reference points. A user
# request NEVER triggers an ECMWF call; only the warmup tour does, and only while BOTH
# MARINE_ENABLED and ECMWF_ENABLED are true.
# ECMWF_ENABLED=true
# ECMWF_BASE_URL=https://data.ecmwf.int/forecasts
# Optional S3 mirror; unset means no failover. (The mirror serves different Content-Type
# headers than the primary — the client accepts both by design.)
# ECMWF_FAILOVER_BASE_URL=https://ecmwf-forecasts.s3.eu-central-1.amazonaws.com
# Horizon in hours. 120 (5 days) is an owner ruling (O1); values above 120 refuse to boot
# because past +144 h the provider's step widens to 6 h and the frozen stepHours=3 contract
# would break. Lowering it is a cost lever.
# ECMWF_FORECAST_HOURS=120
# Per-download timeout (a ~1.8 MB Range GET does not fit the 3 s marine default), the slice of
# one warmup tour ECMWF may take, and the per-tour work ceiling.
# ECMWF_SINGLE_CALL_TIMEOUT_MS=20000
# ECMWF_TOUR_BUDGET_MS=180000
# ECMWF_MAX_STEPS_PER_TOUR=12
# Byte ceilings — breaching one stops the tour LOUDLY (the numeric "no unbounded external
# call"). Measured steady state: ~38 MB per 12-step tour, ~130 MB per full cycle.
# ECMWF_TOUR_MAX_BYTES=67108864
# ECMWF_CYCLE_MAX_BYTES=335544320
# Pre-HTTP cap on ONE planned byte range. The range length comes from the provider's .index and
# becomes our buffering ceiling for that download, so it is never accepted unbounded. 8 MiB is
# ~4.5x the largest measured merged range (~1.83 MB); a plan above it is refused loudly.
# ECMWF_MAX_RANGE_BYTES=8388608
# The THIRD staleness ceiling: maximum age of the model CYCLE a published value may come from.
# The two ceilings below cannot see this failure (an old cycle still yields a step valid "now").
# 24 h tolerates one fully missed cycle, never two.
# ECMWF_CYCLE_MAX_AGE_SECONDS=86400
# Cache-age ceiling of the ECMWF read path (its store refreshes 6-hourly by nature).
# ECMWF_STALE_MAX_SECONDS=43200

# ── CMEMS / Copernicus Marine adapter (marine M4) ──
# Anonymous endpoints — no key, no account, no token (verified 2026-08-02); none of these is a
# secret. The base URLs exist so e2e can point the adapter at a fake server.
# CMEMS_WMTS_BASE_URL=https://wmts.marine.copernicus.eu/teroWmts
# CMEMS_STAC_BASE_URL=https://stac.marine.copernicus.eu/metadata
# Per-call cap for a VALUE call: a session's FIRST call measured 2.54 s (cold TLS), so the shared
# 3 s marine default would manufacture false timeouts. Must not exceed MARINE_UPSTREAM_DEADLINE_MS
# — this is the cap a visitor waits behind.
# CMEMS_SINGLE_CALL_TIMEOUT_MS=6000
# Per-call cap for a STAC CATALOGUE call — its own, longer knob. The resolution phase makes ≤4 ASKS
# per tour, plus one retry each when the resolution is missing, and one ask is up to two HTTP
# attempts — so ≤16 catalogue calls, not ≤8. One failure darkens every point of a product (measured
# 21 of 30 for ~15 minutes) while a value call's failure costs one point; catalogue latency exceeded
# 6 s in 7 of 20 measured draws (max 27.20 s), so 25 s covers at least 19 of those 20. Not raised
# further on purpose: the resolution phase gets two thirds of CMEMS_TOUR_BUDGET_MS (40 s at the
# defaults), inside which 25 s leaves the retry ~14.75 s — a larger cap squeezes that retry for no
# measured gain. Checked at boot against CMEMS_TOUR_BUDGET_MS only — no request path fetches STAC,
# so the request deadline is not this call's ceiling.
# CMEMS_STAC_CALL_TIMEOUT_MS=25000
# The slice of one warmup tour CMEMS may consume. ECMWF_TOUR_BUDGET_MS + CMEMS_TOUR_BUDGET_MS
# must stay below MARINE_WARMUP_DEADLINE_MS (checked at boot). The slice is split in code: two
# thirds bound the STAC resolution phase and the remaining third is the value sweep's guaranteed
# reserve, so a hanging catalogue cannot leave the 78 value keys unrefreshed.
# CMEMS_TOUR_BUDGET_MS=60000
# How long a STAC dataset-id resolution is trusted; a mid-TTL dataset retirement self-heals via
# the 400-triggered forced re-resolution (once per tour).
# CMEMS_STAC_TTL_SECONDS=21600

# Cache TTLs, one per outcome kind. There is deliberately no single MARINE_CACHE_TTL_SECONDS:
# a land mask (permanent), a rate-limit answer (the provider says when) and a schema mismatch
# (an alarm) cannot share one number.
# MARINE_VALUE_TTL_SECONDS=3600
# MARINE_NO_DATA_TTL_SECONDS=86400
# MARINE_ERROR_TTL_SECONDS=60
# MARINE_RATELIMIT_TTL_SECONDS=300
# MARINE_CLIENT_ERROR_TTL_SECONDS=900
# MARINE_SCHEMA_ERROR_TTL_SECONDS=300

# The two independent staleness ceilings: how long we may keep serving a value we cannot
# refresh, and how old the MODEL MOMENT that value describes may be. Both are needed — a value
# fetched a minute ago can still belong to an eight-hour-old model run.
# MARINE_STALE_MAX_SECONDS=21600
# MARINE_VALID_AT_MAX_AGE_SECONDS=10800

# ── Air quality: CAMS via the Copernicus ADS queue ──
# Master kill switch for the leg's UPSTREAM half. `false` by default: a fresh deployment never
# reaches ADS before somebody decided it should, and production is switched on only AFTER the
# ingest has completed one run. The public endpoints are NOT gated by it — they read Postgres
# and answer `unavailable` while the store is cold.
# AIR_QUALITY_ENABLED=false
# The tour's second switch (stop ingesting without taking the feature down) and the leg's OWN
# cadence: its own interval and its own per-tour deadline, never shared with marine's.
# AIR_QUALITY_INGEST_ENABLED=true
# AIR_QUALITY_INGEST_INTERVAL_SECONDS=600
# AIR_QUALITY_INGEST_DEADLINE_MS=300000
# The SECOND daily job — the D−1 analysis archive that gives the page a fixed 24 hours of
# history. Its own switch, so a broken analysis product can be stopped without a deploy: fresh
# forecast data keeps flowing and the published series simply starts at the run hour.
# AIR_QUALITY_ANALYSIS_ENABLED=true
#
# ADS API root (the job protocol lives under /retrieve/v1, which the code appends) and the
# download allowlist, comma-separated HOSTS. Following a provider-supplied result URL off this
# list is SSRF class, so the list is the guard — never a path.
# ADS_API_BASE_URL=https://ads.atmosphere.copernicus.eu/api
# ADS_OBJECT_STORE_HOSTS=object-store.os-api.cci2.ecmwf.int
# The ADS credential. REQUIRED once AIR_QUALITY_ENABLED=true (boot cross-check); with the
# feature off (the default) the server boots without it. It is a SECRET: set it only in the
# deployment environment, never commit a real value. The hand-run probe reads the same
# variable name from ITS OWN shell environment, script-locally — it does not need this file,
# and a hand run never becomes a precondition for the server to start (ENGINEERING.md §5).
# ADS_API_KEY=
#
# The dataset, the requested rectangle "north,west,south,east" (order-checked at boot) and the
# forecast horizon in leadtime hours (0…N inclusive, so 96 means 97 steps).
# AIR_QUALITY_DATASET_ID=cams-europe-air-quality-forecasts
# AIR_QUALITY_AREA=42.5,25.5,35.5,45.0
# AIR_QUALITY_FORECAST_HOURS=96
# Earliest UTC hour a run may be submitted (all CAMS products close by 12:00 UTC) and the
# attempt budget PER JOB — per job, not per run, so a failing analysis cannot eat the
# forecast's budget and keep the page on yesterday's data.
# AIR_QUALITY_SUBMIT_AFTER_UTC_HOUR=12
# AIR_QUALITY_MAX_ATTEMPTS_PER_JOB=6
# Per-call timeouts and the slice of one tour this leg may consume.
# AIR_QUALITY_POLL_TIMEOUT_MS=10000
# AIR_QUALITY_DOWNLOAD_TIMEOUT_MS=180000
# AIR_QUALITY_TOUR_BUDGET_MS=200000
# Byte ceiling for ONE downloaded archive. Decoding is IN PROCESS, so this is a HEAP ceiling,
# not a cost ceiling: 64 MiB is 2.5x the measured 25.26 MiB production archive. A tight ceiling
# fails loudly before any HTTP leaves; a generous one fails as a silent OOM of the API process.
# AIR_QUALITY_RUN_MAX_BYTES=67108864
# The THIRD staleness ceiling: maximum age of the model RUN a published value may come from.
# 48 h tolerates one fully missed run, never two.
# AIR_QUALITY_RUN_MAX_AGE_SECONDS=172800
# AIR_QUALITY_STALE_MAX_SECONDS=43200
# AIR_QUALITY_VALID_AT_MAX_AGE_SECONDS=5400
# Cache TTLs, one per outcome kind (same table shape as marine's).
# AIR_QUALITY_VALUE_TTL_SECONDS=3600
# AIR_QUALITY_NO_DATA_TTL_SECONDS=86400
# AIR_QUALITY_ERROR_TTL_SECONDS=60
# AIR_QUALITY_RATELIMIT_TTL_SECONDS=300
# AIR_QUALITY_CLIENT_ERROR_TTL_SECONDS=900
# AIR_QUALITY_SCHEMA_ERROR_TTL_SECONDS=300

# ── Book video solutions: the YouTube Data API v3 sync leg (SPEC §8/§14) ──
# Master switch for the book leg's REFRESH half — and only that half. `/api/books` and
# `/api/books/{slug}` are NOT gated by it: they read Postgres, and an unseeded store answers an
# empty envelope and a 404, which is a seed state rather than an ingest health state
# (DEC 2026-08-15h item 1). `false` by default so a fresh deployment reaches no provider.
# It does NOT gate the PURGE timer, and that is deliberate: with this switch off the purge still
# runs hourly and still deletes snapshots past the 30-day ceiling. Retiring the feature must not
# retire the obligation to delete what was already stored (Atlas ruling 2026-08-15).
# BOOKS_ENABLED=false
# The refresh tour's own switch, on top of BOOKS_ENABLED. Turning it off stops every provider
# call and, like BOOKS_ENABLED, does NOT stop the purge: deleting expired API Data is an
# obligation (Developer Policies III.E.4.d), and an obligation may not hang off a feature's
# switch. NOTHING switches the purge off — only uninstalling the application does.
# BOOKS_YOUTUBE_SYNC_ENABLED=false
#
# The YouTube Data API v3 credential. REQUIRED once BOOKS_YOUTUBE_SYNC_ENABLED=true (boot
# cross-check); with the sync off (the default) the server boots without it. It is a SECRET: set
# it only in the deployment environment, never commit a real value, and never paste it into an
# issue, a test or a log line. It travels in the `X-goog-api-key` REQUEST HEADER — verified live
# against Data API v3 — so it never enters a URL, a query string or an `Error.cause` chain.
# Restrict the key on Google's side to: API restriction = YouTube Data API v3 only, application
# restriction = the server's IP. Do NOT use an HTTP-referrer restriction: this key never reaches
# a browser, and a referrer restriction would make it usable by anyone who can spoof a header.
# YOUTUBE_API_KEY=
#
# API root (`/videos` is appended by the code) and the tour's cadence. One tour a day is enough:
# the whole catalogue fits a single 50-id call, so a tour costs ONE quota unit against a daily
# allocation of 10 000, and a daily cadence is also what discharges "verify at least every 30
# days that the video has not been deleted".
# YOUTUBE_DATA_API_BASE_URL=https://www.googleapis.com/youtube/v3
# YOUTUBE_SYNC_INTERVAL_SECONDS=86400
# The tour's own budget, the slice of it the provider calls may take, and the cap on one call.
# The chain is checked at boot: one call <= tour slice <= tour deadline < interval.
# YOUTUBE_SYNC_DEADLINE_MS=60000
# YOUTUBE_SYNC_TOUR_BUDGET_MS=30000
# YOUTUBE_SINGLE_CALL_TIMEOUT_MS=10000
# Byte ceiling for ONE response — the numeric form of "no unbounded external call". A 50-video
# snippet+contentDetails+status body is tens of kilobytes; 2 MiB is headroom and still a bound.
# YOUTUBE_RESPONSE_MAX_BYTES=2097152
#
# The two ageing thresholds, and they are not interchangeable:
#   · SOFT (600 h ~ 25 days) — past this age a snapshot stops being SERVED. The response carries
#     `youtube: null`, the page falls back to a typographic facade and emits no VideoObject. The
#     page stays complete; only the enrichment is lost.
#   · HARD (720 h = 30 days) — past this age the row is DELETED by the purge timer. 720 is the
#     ceiling YouTube Developer Policies III.E.4.d places on Non-Authorized API Data, so the boot
#     schema REFUSES a larger value. The knob exists so the ceiling can be lowered, never raised.
# Soft is deliberately below hard: a few failed tours must not put us straight against the wall.
# YOUTUBE_API_DATA_SOFT_MAX_AGE_HOURS=600
# YOUTUBE_API_DATA_HARD_MAX_AGE_HOURS=720
# How often the purge tour runs. It must stay well below a twenty-fourth of the hard ceiling
# (checked at boot), otherwise "at most 30 days" is really 30 days plus one purge interval.
# BOOKS_PURGE_INTERVAL_SECONDS=3600

# ── Hand-run import scripts (NOT read at boot, and NOT read from this file) ──
# One provider key belongs to a HAND-RUN script only. By ENGINEERING.md §5 such a key
# deliberately NEVER enters src/config/env.schema.ts: a migration somebody runs by hand once a
# decade must not become a precondition for the server to start. It is written here so that an
# operator setting up a fresh machine can SEE it exists — not so that it can be set here.
#
# CDS_API_KEY — Copernicus CDS (Climate Data Store), the ERA5-Land climate series. It is a
# SECRET: never commit a real value. It is a SEPARATE VALUE from ADS_API_KEY above, and the code
# reads the two as separate variables — take this one from the CDS side
# (`https://cds.climate.copernicus.eu`, era5-request.ts:20) rather than assuming the ADS value
# works. Do NOT read that as two unrelated systems: both run the same job protocol and, measured,
# the same download host (era5-fetch.ts:81, ADS_OBJECT_STORE_HOSTS above). What is verified here
# is the two service roots and the per-dataset licence acceptance the ERA5-Land run needs
# (data/era5-land/README.md); the account topology behind them is not measured, so do not
# infer it from this file.
# Exactly ONE command reads it, as `process.env.CDS_API_KEY`, script-locally:
#   pnpm db:import:era5 --phase=fetch --raw-dir=<absolute path outside the repo>
# EXPORT IT IN YOUR OWN SHELL for that one command. Writing it into `.env` does NOTHING: that
# CLI runs outside Nest's DI, so no one loads `.env` for it (`@nestjs/config` loads `.env` for
# the SERVER process, docker-compose loads it for the containers below — neither is in this
# CLI's path, and it is started with a plain `node`, no `--env-file`).
# Needed roughly once a decade: the WMO 1991–2020 normal window moves in 2031. The offline half
# — `--phase=load`, and `--phase=fetch --from-file=<absolute path>` — needs no key, no account
# and no network. Full procedure: data/era5-land/README.md, "How to regenerate".

# ── Earthquakes: the AFAD TDVMS ingest (E2, ingest only — no public endpoint yet) ──
# Master switch for the leg's UPSTREAM half. OFF by default: a fresh deployment must never poll a
# public institution's endpoint before somebody decided it should. No credential exists — AFAD
# serves this endpoint anonymously (measured), so there is nothing secret in this block.
# EARTHQUAKE_ENABLED=false
# The tours' own switch, on top of the master one.
# EARTHQUAKE_INGEST_ENABLED=true
# API ROOT. It points at `servisnet` DIRECTLY, and that is the entire handling of the redirect
# trap: `deprem.afad.gov.tr/apiv2/...` answers 302 to this host, and our shared client refuses
# redirects outright, so aiming at the old host would turn every tour into a transient failure.
# AFAD_EVENT_API_BASE_URL=https://servisnet.afad.gov.tr/apigateway/deprem/apiv2
# Two cadences, because the provider revises solutions for DAYS after a large event: the frequent
# tour picks up new events, the rare one catches late revisions.
# EARTHQUAKE_INGEST_INTERVAL_SECONDS=300
# EARTHQUAKE_RECONCILE_INTERVAL_SECONDS=21600
# Each window must stay WIDER than the cadence that repeats it (checked at boot): a narrower
# window leaves a stretch of time nobody ever queries, and events inside it are lost silently.
# EARTHQUAKE_RECENT_WINDOW_HOURS=6
# EARTHQUAKE_RECONCILE_WINDOW_DAYS=7
# One deadline for both tours; the boot checks compare it against BOTH intervals.
# EARTHQUAKE_INGEST_DEADLINE_MS=120000
# EARTHQUAKE_TOUR_BUDGET_MS=60000
# EARTHQUAKE_SINGLE_CALL_TIMEOUT_MS=15000
# `end` is asked for slightly in the future so a clock trailing the provider's does not miss the
# newest event for a whole cycle.
# EARTHQUAKE_CLOCK_SKEW_SECONDS=300
# Byte ceiling for one response, applied to the DECOMPRESSED body — this is a heap ceiling,
# because the body is parsed as JSON in this process.
# EARTHQUAKE_RESPONSE_MAX_BYTES=4194304
# An overflow ALARM, never a "give me the latest N" selector: the provider applies `limit` before
# `orderby`, so a small limit returns the OLDEST rows of the window. A response that reaches this
# number is treated as possibly truncated and refused.
# EARTHQUAKE_SAFETY_LIMIT=20000
# How far beyond Türkiye's outline an event still belongs on the page (DEC 2026-08-17k md.4).
# EARTHQUAKE_SCOPE_BUFFER_KM=200
# Retention for the ingest-run ledger. The newest SUCCESSFUL run is never pruned whatever its age:
# it is the freshness anchor, and losing it turns "the data is stale" into "there is no data".
# EARTHQUAKE_RUN_RETENTION_DAYS=14
# READ PATH: how old the newest successful tour may be before the public endpoints publish
# dataStatus "stale". The data is still served — stale data is shown, never hidden. Must be LARGER
# than EARTHQUAKE_INGEST_INTERVAL_SECONDS or a healthy leg marks itself stale between two tours
# (refused at boot).
# EARTHQUAKE_STALE_MAX_SECONDS=10800

# ── Elevation profile: the AWS terrain-tile leg (CBS-P2 E2) ──
# Master switch. OFF by default, and here it also removes the ROUTE: with the feature off the
# endpoint answers 404 and no branch reaches the provider. No credential exists — the Open Data
# bucket is read anonymously (measured), so there is nothing secret in this block.
# ELEVATION_ENABLED=false
# The us-east-1 Open Data bucket. Verified live; the EU bucket answered 403 and its correct
# address form is unknown, so it is deliberately not the default.
# ELEVATION_BASE_URL=https://s3.amazonaws.com/elevation-tiles-prod
# Total upstream budget for ONE user request — every tile, every retry, together. Measured basis:
# median 254 ms and p95 730 ms per tile, and a long line needs ~73 distinct tiles, which closes in
# ~8.9 s at p95 with the concurrency below. The very longest lines do NOT fit and come back as a
# PARTIAL profile on a cold cache — that is the designed warming path, not a failure.
# ELEVATION_UPSTREAM_DEADLINE_MS=12000
# Ceiling on ONE tile fetch; ~3.4× the slowest tile measured (1449 ms). Must be STRICTLY below the
# request budget above — equality is refused at boot too, unlike the marine pairs. A cap equal to
# the budget tells the upstream client that every call gets the whole window; on a leg that drains
# a tile queue across one budget it does not, and the late tiles would then be recorded as provider
# failures until the circuit opened.
# ELEVATION_SINGLE_CALL_TIMEOUT_MS=5000
# LOUD-stop ceiling on the tiles ONE request may touch. It may not be set BELOW the fixed sample
# count (refused at boot): a request cannot touch more distinct tiles than it samples points, so a
# lower ceiling only refuses work the endpoint is designed to do.
# ELEVATION_MAX_TILES_PER_REQUEST=220
# How many tile fetches one request may have in flight against the bucket.
# ELEVATION_TILE_FETCH_CONCURRENCY=6
# Byte ceiling for ONE tile. Real tiles measured 757 B (sea) to 133 kB (mountain), so this is ~4×
# the largest; a body past it is a contract surprise, not something to retry.
# ELEVATION_TILE_MAX_RESPONSE_BYTES=524288
# The in-process decoded-tile cache, in tiles. One decoded tile is exactly 128 KiB, so 256 tiles
# is ~33.5 MB. Must not be smaller than ELEVATION_MAX_TILES_PER_REQUEST (refused at boot), or a
# single long line evicts its own tiles while it is still running.
# ELEVATION_TILE_CACHE_MAX_TILES=256
# Freshness horizon of a cached profile. Long because the source tiles are immutable — the
# bucket's own Last-Modified is 2017-11-17.
# ELEVATION_PROFILE_TTL_SECONDS=86400
# Negative TTLs. The schema one is shortest on purpose: that is where the imagery-source tripwire
# lands, and a licence-relevant surprise must be re-checked soon rather than parked.
# ELEVATION_ERROR_TTL_SECONDS=60
# ELEVATION_CLIENT_ERROR_TTL_SECONDS=900
# ELEVATION_SCHEMA_ERROR_TTL_SECONDS=300

# ── Local infrastructure (consumed by docker-compose to provision Postgres) ──
# Dev-only defaults; NOT secrets. Real credentials live in the deployment
# environment once hosting is decided. Keep these in sync with DATABASE_URL.
POSTGRES_USER=cografya
POSTGRES_PASSWORD=cografya_dev
POSTGRES_DB=cografya
POSTGRES_PORT=5432
REDIS_PORT=6379
