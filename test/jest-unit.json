{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(tools|src)/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.unit-spec.json" }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.ts$": "$1"
  }
}
