{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  // `tools/` is build-time tooling run by Node's type stripping, never bundled into
  // `dist/` — it has its own project at `tools/tsconfig.json`. The NetCDF3/ZIP fixture
  // builder, the ERA5 synthetic-file builder and the shared No-Endorsement denylist are
  // test infrastructure that live in `src/` only so the unit lane collects their specs —
  // they must never ship to `dist/`.
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "tools",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "src/air-quality/cams/netcdf3-fixture.builder.ts",
    "src/database/era5/era5-fixture.builder.ts",
    "src/elevation/terrain/terrarium-fixture.builder.ts",
    "src/common/attribution/endorsement-guard.ts",
    // The ALL-CAPS → reader's-writing conversion behind the two generated reference lists. It runs
    // when those lists are REGENERATED and when `reference-lists.spec.ts` re-derives them to check
    // that they still match the archived source; no request path reaches it, because the published
    // names are already committed constants. Same class as the fixture builders above — it lives in
    // `src/` so the unit lane collects its checks, and must not ship to `dist/`.
    "src/reference/reference-writing-form.ts"
  ]
}
