{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  // `tools/` is build-time tooling run by Node's type stripping, never bundled into
  // `dist/` — it has its own project at `tools/tsconfig.json`.
  "exclude": ["node_modules", "test", "dist", "tools", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
